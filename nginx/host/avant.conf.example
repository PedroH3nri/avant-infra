# Exemplo para o nginx do host (o que já termina o TLS na VM, com certbot).
# Copie para /etc/nginx/sites-available/avant.conf e ative. Cada VM fica só com os blocos
# do seu ambiente (os dois de cada um são iguais, menos o domínio e a porta):
#   produção (VM principal): avant.groone.com          -> 127.0.0.1:8080
#   staging (VM menor):      staging.avant.groone.com  -> 127.0.0.1:8081
# O map e o log_format do começo valem para os dois e ficam nas duas VMs.

# Os tokens de convite e de nova senha vão na URL (/convite/<token>, /redefinir-senha/<token> e
# /api/v1/auth/invitations/<token>) e no Referer das chamadas seguintes: o access_log de cada
# server usa este formato, que grava *** no lugar deles.
map $request $avant_log_request {
    "~^(?<token_prefix>.*?/(?:api/v1/auth/invitations|convite|redefinir-senha)/)[^/?#\s]+(?<token_suffix>.*)$" "${token_prefix}***${token_suffix}";
    default $request;
}
map $http_referer $avant_log_referer {
    "~^(?<token_prefix>.*?/(?:api/v1/auth/invitations|convite|redefinir-senha)/)[^/?#\s]+(?<token_suffix>.*)$" "${token_prefix}***${token_suffix}";
    default $http_referer;
}
log_format avant_redacted '$remote_addr - $remote_user [$time_local] "$avant_log_request" '
                          '$status $body_bytes_sent "$avant_log_referer" "$http_user_agent"';

# ---------------------------------------------------------------- produção

server {
    listen 443 ssl http2;
    server_name avant.groone.com;
    access_log /var/log/nginx/access.log avant_redacted;
    # Erros só a partir de crit: o 502 do upstream gravaria a linha da requisição com o token do
    # convite (o error_log não tem formato). O status do 502 fica no access_log, sem o token.
    error_log /var/log/nginx/error.log crit;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/avant.groone.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/avant.groone.com/privkey.pem;

    # Só TLS 1.2 e 1.3. Sem OCSP stapling: os certificados atuais do Let's Encrypt não têm OCSP.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:avant_tls:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 2m;

    # SSE: todo proxy no caminho precisa estar sem buffer.
    location = /api/v1/events {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # Documentos da Empresa: o core aceita até 5 MB; o resto do painel fica em 2 MB.
    location ~ ^/api/v1/company/documents/[a-z_]+$ {
        client_max_body_size 6m;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Nunca para a internet.
    location = /api/v1/metrics {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}

server {
    listen 80;
    server_name avant.groone.com;
    access_log /var/log/nginx/access.log avant_redacted;
    # Erros só a partir de crit: o 502 do upstream gravaria a linha da requisição com o token do
    # convite (o error_log não tem formato). O status do 502 fica no access_log, sem o token.
    error_log /var/log/nginx/error.log crit;
    server_tokens off;
    return 301 https://$host$request_uri;
}

# ---------------------------------------------------------------- staging

server {
    listen 443 ssl http2;
    server_name staging.avant.groone.com;
    access_log /var/log/nginx/access.log avant_redacted;
    # Erros só a partir de crit: o 502 do upstream gravaria a linha da requisição com o token do
    # convite (o error_log não tem formato). O status do 502 fica no access_log, sem o token.
    error_log /var/log/nginx/error.log crit;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/staging.avant.groone.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/staging.avant.groone.com/privkey.pem;

    # Só TLS 1.2 e 1.3. Sem OCSP stapling: os certificados atuais do Let's Encrypt não têm OCSP.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:avant_tls:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 2m;

    # SSE: todo proxy no caminho precisa estar sem buffer.
    location = /api/v1/events {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # Documentos da Empresa: o core aceita até 5 MB; o resto do painel fica em 2 MB.
    location ~ ^/api/v1/company/documents/[a-z_]+$ {
        client_max_body_size 6m;
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Nunca para a internet.
    location = /api/v1/metrics {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}

server {
    listen 80;
    server_name staging.avant.groone.com;
    access_log /var/log/nginx/access.log avant_redacted;
    # Erros só a partir de crit: o 502 do upstream gravaria a linha da requisição com o token do
    # convite (o error_log não tem formato). O status do 502 fica no access_log, sem o token.
    error_log /var/log/nginx/error.log crit;
    server_tokens off;
    return 301 https://$host$request_uri;
}
