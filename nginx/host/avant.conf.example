# Exemplo para o nginx do host (o que já termina o TLS na VM, com certbot).
# Copie para /etc/nginx/sites-available/, troque o domínio e a porta e ative.
#   produção: avant.groone.com          -> 127.0.0.1:8080
#   staging:  staging.avant.groone.com  -> 127.0.0.1:8081

server {
    listen 443 ssl http2;
    server_name avant.groone.com;

    ssl_certificate     /etc/letsencrypt/live/avant.groone.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/avant.groone.com/privkey.pem;

    # Só TLS 1.2 e 1.3, com OCSP stapling (o certificado do certbot traz a cadeia).
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:avant_tls:10m;
    ssl_session_timeout 1d;
    ssl_stapling on;
    ssl_stapling_verify on;
    ssl_trusted_certificate /etc/letsencrypt/live/avant.groone.com/chain.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 2m;

    # SSE: todo proxy no caminho precisa estar sem buffer.
    location = /api/v1/events {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # Documentos da Empresa: o core aceita até 5 MB; o resto do painel fica em 2 MB.
    location ~ ^/api/v1/company/documents/[a-z_]+$ {
        client_max_body_size 6m;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Nunca para a internet.
    location = /api/v1/metrics {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}

server {
    listen 80;
    server_name avant.groone.com;
    return 301 https://$host$request_uri;
}
