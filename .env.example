# Copie para .env e preencha. O .env nunca vai para o Git.
# Em staging e produção os valores ficam só nas VMs.

# Ambiente: local, staging ou production
AVANT_ENV=local

# PostgreSQL
POSTGRES_DB=avant
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
AVANT_OWNER_PASSWORD=
AVANT_APP_PASSWORD=
# Usado pela aplicação (papel sem BYPASSRLS)
DATABASE_URL=postgresql+psycopg://avant_app:SENHA@postgres:5432/avant
# Usado só pelas migrations
DATABASE_MIGRATIONS_URL=postgresql+psycopg://avant_owner:SENHA@postgres:5432/avant

# RabbitMQ (broker do Celery). Obrigatório em todo ambiente: sem ele, a api e o worker não
# sobem. No compose local, a URL dos containers é montada a partir da senha.
RABBITMQ_USER=avant
RABBITMQ_PASSWORD=
CELERY_BROKER_URL=amqp://avant:SENHA@rabbitmq:5672//

# Redis (resultados, travas, limites e eventos do SSE). Obrigatório em todo ambiente;
# nas VMs, com senha.
REDIS_URL=redis://redis:6379/0

# Sessão e segurança
SESSION_SECRET=
# Chave Fernet que cifra os segredos do 2FA. Gerar com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Trocar a chave invalida o 2FA de quem já configurou.
MFA_ENCRYPTION_KEY=
APP_BASE_URL=https://avant.localhost

# nginx local (HTTPS em https://avant.localhost). Por padrão manda para o uvicorn e o Vite da
# máquina; para o perfil app do compose, use api:8000 e web:8080.
AVANT_API_UPSTREAM=host.docker.internal:8000
AVANT_WEB_UPSTREAM=host.docker.internal:5173

# Rede do compose local com subnet fixa: o nginx tem IP fixo, o único de quem a api em container
# (perfil app) aceita X-Forwarded-For. Troque as três juntas se conflitarem com uma rede sua.
AVANT_LOCAL_SUBNET=10.250.0.0/24
AVANT_LOCAL_DYNAMIC_IP_RANGE=10.250.0.128/25
AVANT_LOCAL_NGINX_IP=10.250.0.10

# Endereços do proxy de quem a api aceita X-Forwarded-For (só IPs ou redes, nunca "*"; sem ela a
# api não sobe). No perfil app o compose usa o AVANT_LOCAL_NGINX_IP. Com a api rodando na
# máquina (docs/desenvolvimento.md): 127.0.0.1 no macOS, o AVANT_LOCAL_NGINX_IP no Linux.
# Nas VMs, o compose usa o AVANT_NGINX_IP do vm.env.
FORWARDED_ALLOW_IPS=127.0.0.1

# Google OAuth (login com Google)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Ad Manager (conta de serviço da Groone)
GAM_SERVICE_ACCOUNT_FILE=/run/secrets/gam-service-account.json
GAM_GROONE_NETWORK_CODE=
GAM_APPLICATION_NAME=Groone Avant

# Page views do iGroone/data (Mongo, usuário só de leitura; vazio = não sincroniza)
PAGE_VIEWS_MONGO_URL=
PAGE_VIEWS_MONGO_DATABASE=admanager

# Cotações do dólar (Open Exchange Rates, plano grátis; vazio = painel só em dólar)
OPENEXCHANGERATES_APP_ID=

# Resend (e-mails). Obrigatório em todo ambiente: sem a chave, a api e o worker não sobem, e
# nenhum link (convite, nova senha) vai para o log. No desenvolvimento, crie a sua chave em
# https://resend.com/api-keys (permissão "Sending access") e use o remetente do sandbox, que
# só entrega no e-mail da sua conta do Resend. Nunca commite a chave.
# Nas VMs, o remetente é Avant <nao-responda@avant.groone.com>.
RESEND_API_KEY=
MAIL_FROM="Avant <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# VMs (staging e produção): os valores ficam em /srv/avant/<ambiente>/, nunca no Git.
# O que não é segredo (réplicas, portas, URL) está em compose/<ambiente>/vm.env.
#
# /srv/avant/<ambiente>/compose.env, lido pelo docker compose:
#   POSTGRES_SUPERUSER_PASSWORD=
#   AVANT_OWNER_PASSWORD=
#   AVANT_APP_PASSWORD=
#   RABBITMQ_PASSWORD=
#   REDIS_PASSWORD=
#   (DATABASE_URL, CELERY_BROKER_URL e REDIS_URL são montadas pelo compose a partir delas)
#
# /srv/avant/<ambiente>/app.env, entregue aos containers da aplicação:
#   SESSION_SECRET=
#   MFA_ENCRYPTION_KEY=
#   RESEND_API_KEY=
#   MAIL_FROM=
#   GOOGLE_OAUTH_CLIENT_ID=
#   GOOGLE_OAUTH_CLIENT_SECRET=
#   GAM_SERVICE_ACCOUNT_EMAIL=
#   GAM_GROONE_NETWORK_CODE=
#   GAM_APPLICATION_NAME=
#   PAGE_VIEWS_MONGO_URL=
#   PAGE_VIEWS_MONGO_DATABASE=
#   OPENEXCHANGERATES_APP_ID=
#
# /srv/avant/<ambiente>/gam-service-account.json: chave da conta de serviço,
# montada só no worker-gam.
