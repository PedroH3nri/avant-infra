# Copie para .env e preencha. O .env nunca vai para o Git.
# Em staging e produção os valores ficam só nas VMs.

# Ambiente: local, staging ou production
AVANT_ENV=local

# PostgreSQL
POSTGRES_DB=avant
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
AVANT_OWNER_PASSWORD=
AVANT_APP_PASSWORD=
# Usado pela aplicação (papel sem BYPASSRLS)
DATABASE_URL=postgresql+psycopg://avant_app:SENHA@postgres:5432/avant
# Usado só pelas migrations
DATABASE_MIGRATIONS_URL=postgresql+psycopg://avant_owner:SENHA@postgres:5432/avant

# RabbitMQ (broker do Celery)
RABBITMQ_USER=avant
RABBITMQ_PASSWORD=
CELERY_BROKER_URL=amqp://avant:SENHA@rabbitmq:5672//

# Redis (resultados, locks, limites e eventos do SSE)
REDIS_URL=redis://redis:6379/0

# Sessão e segurança
SESSION_SECRET=
# Chave Fernet que cifra os segredos do 2FA. Gerar com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Trocar a chave invalida o 2FA de quem já configurou.
MFA_ENCRYPTION_KEY=
APP_BASE_URL=http://localhost:8080

# Google OAuth (login com Google)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Ad Manager (conta de serviço da Groone)
GAM_SERVICE_ACCOUNT_FILE=/run/secrets/gam-service-account.json
GAM_GROONE_NETWORK_CODE=
GAM_APPLICATION_NAME=Groone Avant

# Resend (e-mails, domínio avant.groone.com)
RESEND_API_KEY=
MAIL_FROM=Avant <nao-responda@avant.groone.com>
