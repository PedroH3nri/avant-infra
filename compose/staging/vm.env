# Staging (VM menor, 4 vCPU / 8 GB, junto com Jenkins, Grafana, Prometheus e backups).
# Sem segredos: as senhas ficam em /srv/avant/staging/compose.env e app.env na VM.
AVANT_ENV=staging
AVANT_STATE_DIR=/srv/avant/staging
APP_BASE_URL=https://staging.avant.groone.com
AVANT_HTTP_BIND=127.0.0.1:8081
POSTGRES_HOST_PORT=5434

API_REPLICAS=1
WEB_REPLICAS=1
WORKER_CONCURRENCY=2
WORKER_GAM_CONCURRENCY=1

# 2 processos da API x 15 conexões x 2 cores no deploy, mais os workers e o migrate.
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
REDIS_MAXMEMORY=128mb

# Tetos menores que os da produção (os padrões estão no docker-compose.yml).
POSTGRES_MEM_LIMIT=1g
POSTGRES_CPUS=2
API_MEM_LIMIT=768m
API_CPUS=1
WORKER_MEM_LIMIT=1536m
WORKER_CPUS=2
WORKER_GAM_MEM_LIMIT=1g
WORKER_GAM_CPUS=1
REDIS_MEM_LIMIT=256m
RABBITMQ_MEM_LIMIT=512m
