# Produção (VM principal, 16 vCPU / 32 GB, junto com Genius, Data e MongoDB).
# Sem segredos: as senhas ficam em /srv/avant/production/compose.env e app.env na VM.
AVANT_ENV=production
AVANT_STATE_DIR=/srv/avant/production
APP_BASE_URL=https://avant.groone.com
AVANT_HTTP_BIND=127.0.0.1:8080
POSTGRES_HOST_PORT=5433

# Mínimo de 2 instâncias de api e de web (CLAUDE.md).
API_REPLICAS=2
WEB_REPLICAS=2
WORKER_CONCURRENCY=4
WORKER_GAM_CONCURRENCY=2

POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=2GB
REDIS_MAXMEMORY=512mb
